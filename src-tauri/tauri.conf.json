{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppImage Manager",
  "version": "0.1.0",
  "identifier": "com.pedrolobato.appimagelauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppImage Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "AppImage desktop launcher",
    "longDescription": "AppImage Manager helps you import, organize, validate permissions and launch AppImage applications on Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "templates/appimage-manager.desktop",
        "postInstallScript": "scripts/postinst.sh",
        "postRemoveScript": "scripts/postrm.sh"
      }
    }
  }
}
